{
  "name": "joeyddong-homepage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "routes": [
    { "pattern": "joeyddong.top", "custom_domain": true },
    { "pattern": "www.joeyddong.top", "custom_domain": true },
    { "pattern": "joeyddong-site.top", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
