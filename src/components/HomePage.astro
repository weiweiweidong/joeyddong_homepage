---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages, pagePath, type Locale } from '../lib/i18n';
import { site, destinationUrl } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = messages[locale];
---

<BaseLayout locale={locale} page="home" title={`${site.name} — Ideas, Work & Life`} description={copy.home.aboutDescription}>
  <div class="home-background" aria-hidden="true">
    <span class="home-background__circle"></span>
    <span class="home-background__panel"></span>
    <span class="home-background__ring"></span>
  </div>
  <main id="main-content" class="home-main">
    <section class="hero shell" aria-labelledby="home-title">
      <div class="hero-content">
        <h1 class="hero-title" id="home-title"><span>{copy.home.greeting}</span><span>{copy.home.headline}</span></h1>
        <p class="hero-description">{copy.home.tagline}</p>
      </div>
      <a class="scroll-cue" href="#explore-title" aria-label={copy.home.exploreEyebrow}><span aria-hidden="true">↓</span></a>
      <button class="background-motion-toggle" type="button" aria-label={copy.home.motionLabel} aria-pressed="false" data-play-label={copy.home.motionPlay} data-pause-label={copy.home.motionPause} hidden>{copy.home.motionPlay}</button>
    </section>

    <section class="explore content-shell section-space" aria-labelledby="explore-title">
      <p class="eyebrow">{copy.home.exploreEyebrow}</p>
      <h2 id="explore-title">{copy.home.exploreTitle}</h2>
      <a class="feature-card projects-card" href={destinationUrl('projects', locale)}>
        <div class="card-copy"><p class="card-kicker">01 / CODING, VIBE CODING & DATA SCIENCE</p><h3>{copy.navigation.projects}</h3><p>{copy.home.projectsDescription}</p></div>
        <div class="project-art" aria-hidden="true">
          <div class="mini-project code-project"><span class="mini-label">CODING</span><span class="code-symbol">&lt;/&gt;</span><div class="code-lines"><i></i><i></i><i></i></div></div>
          <div class="mini-project vibe-project"><span class="mini-label">VIBE CODING</span><svg viewBox="0 0 200 180"><path d="M100 18 117 66 167 49 137 92 180 120 129 120 137 171 100 138 63 171 71 120 20 120 63 92 33 49 83 66Z" fill="currentColor"/></svg></div>
          <div class="mini-project data-project"><span class="mini-label">DATA SCIENCE</span><svg viewBox="0 0 200 180"><path d="M20 148H180M20 32V148" fill="none" stroke="currentColor" stroke-width="2" opacity=".35"/><rect x="37" y="103" width="22" height="45" rx="3"/><rect x="73" y="78" width="22" height="70" rx="3"/><rect x="109" y="89" width="22" height="59" rx="3"/><rect x="145" y="42" width="22" height="106" rx="3"/></svg></div>
        </div>
        <div class="card-bottom"><span>{copy.home.projectsLink}</span><span class="circle-arrow" aria-hidden="true">↗</span></div>
      </a>
      <div class="secondary-cards">
        <a class="feature-card blog-card" href={destinationUrl('blog', locale)}>
          <div class="card-copy"><p class="card-kicker">02 / NOTES & IDEAS</p><h3>{copy.navigation.blog}</h3><p>{copy.home.blogDescription}</p></div>
          <div class="blog-art" aria-hidden="true"><div class="note-sheet"><span>“</span><i></i><i></i><i></i><i></i></div><span class="note-asterisk">✳</span></div>
          <div class="card-bottom"><span>{copy.home.blogLink}</span><span class="circle-arrow" aria-hidden="true">↗</span></div>
        </a>
        <a class="feature-card photography-card" href={destinationUrl('photography', locale)}>
          <div class="card-copy"><p class="card-kicker">03 / THROUGH MY LENS</p><h3>{copy.navigation.photography}</h3><p>{copy.home.photographyDescription}</p></div>
          <div class="photography-art" aria-hidden="true"><svg viewBox="0 0 400 250"><rect x="42" y="20" width="316" height="210" rx="8" fill="#284a44"/><circle cx="263" cy="83" r="35" fill="#ffe8a5"/><path d="m42 230 103-145 124 145Z" fill="#9fc6ad"/><path d="m177 230 90-111 91 111Z" fill="#58896c"/><path d="M70 69V45h24M306 45h24v24M330 181v24h-24M94 205H70v-24" fill="none" stroke="#fff9ed" stroke-width="3"/><path d="M190 125h20M200 115v20" stroke="#fff9ed" stroke-width="2"/></svg></div>
          <div class="card-bottom"><span>{copy.home.photographyLink}</span><span class="circle-arrow" aria-hidden="true">↗</span></div>
        </a>
      </div>
    </section>

    <section class="about-preview content-shell section-space" aria-labelledby="about-title">
      <p class="eyebrow">{copy.home.aboutEyebrow}</p><h2 id="about-title">{copy.home.aboutTitle}</h2>
      <a class="profile-card" href={pagePath(locale, 'portfolio')}>
        <div class="profile-copy"><p class="card-kicker">04 / THE PERSON BEHIND THE PAGES</p><h3>{site.name}.</h3><p>{copy.home.aboutDescription}</p><span class="profile-link">{copy.home.aboutLink}<span class="circle-arrow" aria-hidden="true">↗</span></span></div>
        <figure class="profile-portrait"><img src={site.portrait} alt={copy.home.portraitAlt} width="500" height="500" loading="lazy" /><figcaption>{copy.home.portraitCaption}</figcaption></figure>
      </a>
    </section>
  </main>
</BaseLayout>

<script>
  const background = document.querySelector<HTMLElement>('.home-background');
  const motionToggle = document.querySelector<HTMLButtonElement>('.background-motion-toggle');
  if (background && motionToggle) {
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    let manuallySelected = false;
    const setMotion = (enabled: boolean) => {
      background.dataset.motion = enabled ? 'on' : 'off';
      motionToggle.setAttribute('aria-pressed', String(enabled));
      motionToggle.textContent = (enabled ? motionToggle.dataset.pauseLabel : motionToggle.dataset.playLabel) ?? '';
    };
    setMotion(!preference.matches);
    motionToggle.hidden = false;
    motionToggle.addEventListener('click', () => {
      manuallySelected = true;
      setMotion(background.dataset.motion !== 'on');
    });
    preference.addEventListener('change', (event) => {
      if (!manuallySelected) setMotion(!event.matches);
    });
  }
</script>
