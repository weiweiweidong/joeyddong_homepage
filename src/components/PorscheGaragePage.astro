---
import BaseLayout from '../layouts/BaseLayout.astro';
import PorscheGarage from './PorscheGarage.astro';
import { pagePath, type Locale } from '../lib/i18n';
import { projects } from '../lib/projects';
import { porscheCopy } from '../lib/porsche-copy';
import { site } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = porscheCopy[locale];
---
<BaseLayout locale={locale} page="projects/porsche-garage" title={`${copy.name} — ${site.name}`} description={copy.description}>
  <main class="shell garage-main" id="main-content">
    <header>
      <a class="project-back" href={pagePath(locale, 'projects')}><span aria-hidden="true">←</span> {projects[locale].backToProjects}</a>
      <p class="eyebrow">03 / VIBE CODING</p>
      <h1>{copy.name}</h1>
      <p class="description">{copy.description}</p>
    </header>
    <PorscheGarage copy={copy} />
    <p class="model-credit"><a href="https://sketchfab.com/3d-models/free-1975-porsche-911-930-turbo-8568d9d14a994b9cae59499f0dbed21e" target="_blank" rel="noreferrer">{copy.credit} ↗</a><br /><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">{copy.license}</a></p>
  </main>
</BaseLayout>
<style>
  .garage-main { padding-block: clamp(40px, 6vw, 80px) 90px; }
  header { max-width: 850px; margin-bottom: 36px; }
  .project-back { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-bottom: 24px; font-size: 14px; }
  .project-back:hover, .model-credit a:hover { text-decoration: underline; }
  h1 { margin-top: 20px; font-size: clamp(44px, 6.5vw, 88px); line-height: 1.12; letter-spacing: -.045em; }
  .description { max-width: 640px; margin-top: 24px; font-size: 18px; line-height: 1.8; }
  .model-credit { margin-top: 22px; font-size: 11px; line-height: 1.9; opacity: .8; }
</style>
