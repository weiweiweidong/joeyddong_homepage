---
import type { CatYardCopy } from '../lib/cat-yard-copy';
interface Props { copy?: CatYardCopy; preview?: boolean }
const { copy, preview = false } = Astro.props;
---
<svg class="yard-scene" viewBox="0 0 960 580" xmlns="http://www.w3.org/2000/svg" role={preview ? undefined : 'group'} aria-label={copy?.sceneLabel} aria-hidden={preview ? 'true' : undefined}>
  <rect width="960" height="580" fill="#faf1de" />
  <circle cx="789" cy="86" r="39" fill="#f4cf78" />
  <g fill="#fffaf0"><path d="M130 98c-20-32-62-24-67 6-39-4-49 33-22 42h151c30-19 4-51-24-39-6-18-25-22-38-9Z"/><path d="M503 65c-13-24-43-23-51 2-25-6-45 22-24 36h119c22-19 2-40-20-30-5-13-14-13-24-8Z"/></g>
  <path d="M0 225Q110 160 242 213T500 210T760 194T960 218V410H0Z" fill="#d8dfb1" />
  <g fill="#ead7b8" stroke="#ceba96" stroke-width="2">
    {Array.from({length:17}, (_, i) => <path d={`M${i*60-10} 287v-91l20-18 20 18v91Z`} />)}
    <path d="M0 226h960v12H0ZM0 268h960v12H0Z" />
  </g>
  <path d="M0 310Q240 264 460 305T960 298V580H0Z" fill="#bfcea0" />
  <path d="M0 430Q280 361 520 411T960 420V580H0Z" fill="#b0c28e" />
  <ellipse cx="478" cy="407" rx="351" ry="113" fill="#d8d7af" opacity=".55" />
  <g fill="#7f9c68">
    {[[47,302],[878,310],[93,501],[848,502]].map(([x,y]) => <g transform={`translate(${x} ${y})`}><path d="M0 0Q-40-52-23-61Q-2-53 0-17Q8-76 27-65Q42-45 7 0Z"/><path d="M0 0Q-56-18-46-32Q-17-39 0 0" fill="#91ac76"/></g>)}
  </g>
  <g stroke="#7f9c68" stroke-width="3" fill="#fff3d0">
    {[[79,312],[895,340],[102,495],[827,513]].map(([x,y],i) => <g transform={`translate(${x} ${y})`}><path d="M0 10v-27"/><circle cy="-22" r="10" stroke="none" fill={i%2 ? '#e7a090' : '#fff3d0'}/><circle cy="-22" r="4" stroke="none" fill="#d5ad57"/></g>)}
  </g>
  <g fill="#6f8d5d" opacity=".5">
    {Array.from({length:30},(_,i) => <path d={`M${110+i*24} ${330+(i*47%206)}l-3-7m3 7 4-6`} stroke="#6f8d5d" stroke-width="1.5" />)}
  </g>
  <g transform="translate(780 380)" data-bowl role={preview ? undefined : 'button'} tabindex={preview ? undefined : '0'} aria-label={copy?.bowlLabel}>
    <ellipse cy="23" rx="46" ry="12" fill="#768254" opacity=".2"/>
    <path d="M-39-4h78l-8 25q-32 14-62 0Z" fill="#c37862" stroke="#9d5d4d" stroke-width="2"/>
    <ellipse cy="-4" rx="39" ry="13" fill="#f1c7a0" stroke="#9d5d4d" stroke-width="2"/>
    <g data-kibble fill="#855840">{Array.from({length:16},(_,i) => <ellipse cx={-26+(i%6)*10} cy={-8+Math.floor(i/6)*5} rx="4" ry="3" />)}</g>
    <path d="M-8 12q8-6 16 0m-11 0 3-4 3 4" fill="none" stroke="#f8debd" stroke-width="2"/>
    <rect x="-48" y="-27" width="96" height="64" fill="transparent"/>
  </g>
  <g data-yarn transform="translate(345 419)" role={preview ? undefined : 'button'} tabindex={preview ? undefined : '0'} aria-label={copy?.yarnLabel}>
    <ellipse cy="19" rx="27" ry="7" fill="#768254" opacity=".2"/>
    <path d="M9 17q23 26 45 5t20 9" fill="none" stroke="#b67785" stroke-width="2.5" stroke-linecap="round"/>
    <circle r="22" fill="#da9aa5" stroke="#ad6f7e" stroke-width="2"/>
    <g fill="none" stroke="#b67785" stroke-width="1.5"><path d="M-17-14Q18-1 15 16M-21-4Q7 10 5 21M-16 13Q-6-18 10-18M-7 20Q-2-15 17-12M-21 5Q-9-8 19 5"/></g>
    <circle r="32" fill="transparent"/>
  </g>
  <g data-ball transform="translate(590 450)" role={preview ? undefined : 'button'} tabindex={preview ? undefined : '0'} aria-label={copy?.ballLabel}>
    <ellipse cy="18" rx="24" ry="6" fill="#768254" opacity=".2"/>
    <g data-ball-spin><circle r="19" fill="#80adb0" stroke="#54888d" stroke-width="2"/><path d="M-13-14Q12-8 13 14M-18 6Q0-6 18-6" fill="none" stroke="#f4e8c9" stroke-width="4"/><circle cx="-8" cy="-8" r="4" fill="#fff" opacity=".35"/></g>
    <circle r="30" fill="transparent"/>
  </g>
  <g data-cat transform="translate(470 375)" role={preview ? undefined : 'button'} tabindex={preview ? undefined : '0'} aria-label={copy?.catLabel}>
    <ellipse data-shadow cx="0" cy="8" rx="55" ry="11" fill="#65794e" opacity=".2"/>
    <g data-cat-body>
      <path data-tail d="M-35-28C-88-32-66-82-88-71" fill="none" stroke="#bd784b" stroke-width="15" stroke-linecap="round"/>
      <g data-back-leg><path d="M-24-24v27" stroke="#bd784b" stroke-width="16" stroke-linecap="round"/></g>
      <ellipse cx="-5" cy="-33" rx="42" ry="29" fill="#d99a62" stroke="#b8794c" stroke-width="2"/>
      <ellipse cx="8" cy="-27" rx="21" ry="18" fill="#f7dfb9"/>
      <path d="M-20-56l-3 15M-5-61l-3 15" stroke="#b8794c" stroke-width="5" stroke-linecap="round"/>
      <g data-held-yarn opacity="0">
        <circle cx="23" cy="-20" r="22" fill="#da9aa5" stroke="#ad6f7e" stroke-width="2"/>
        <path d="M6-34q32 13 29 30M2-24q28 14 26 26M7-7q10-31 26-31M16 0q5-35 24-32" fill="none" stroke="#b67785" stroke-width="1.5"/>
        <path d="M39-38q15 12 4 23" fill="none" stroke="#e7ae76" stroke-width="12" stroke-linecap="round"/>
      </g>
      <g data-held-ball opacity="0">
        <circle cx="23" cy="-20" r="19" fill="#80adb0" stroke="#54888d" stroke-width="2"/>
        <path d="M10-34q25 6 26 28M5-14q18-12 36-12" fill="none" stroke="#f4e8c9" stroke-width="4"/>
        <path d="M39-38q15 12 4 23" fill="none" stroke="#e7ae76" stroke-width="12" stroke-linecap="round"/>
      </g>
      <g data-front-leg><path d="M23-25v28" stroke="#e7ae76" stroke-width="16" stroke-linecap="round"/></g>
      <g data-head>
        <path d="M0-63-4-105 22-89 43-94 65-108 61-63Z" fill="#d99a62" stroke="#b8794c" stroke-width="2" stroke-linejoin="round"/>
        <path d="M2-98 5-78 17-88M57-100 45-87 57-78" fill="#e9afa0"/>
        <ellipse cx="29" cy="-65" rx="36" ry="29" fill="#e7ae76"/>
        <path d="M21-91l4 10M34-93l-1 11" stroke="#b8794c" stroke-width="4" stroke-linecap="round"/>
        <g data-eyes fill="#4c443b"><ellipse cx="15" cy="-68" rx="3.5" ry="5"/><ellipse cx="43" cy="-68" rx="3.5" ry="5"/></g>
        <g data-happy-eyes stroke="#4c443b" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0"><path d="M10-67q5-6 10 0M38-67q5-6 10 0"/></g>
        <ellipse cx="21" cy="-54" rx="11" ry="9" fill="#f7dfb9"/><ellipse cx="37" cy="-54" rx="11" ry="9" fill="#f7dfb9"/>
        <path d="m25-59 8 0-4 5Z" fill="#b5706b"/><path d="M29-54v5m-7-1q7 5 14 0" fill="none" stroke="#795b4c" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M7-55-15-59M7-50-16-48M51-55l23-5M51-50l22 3" stroke="#795b4c" stroke-width="1.3" stroke-linecap="round"/>
      </g>
    </g>
    <path data-heart d="M25-135c-16-18-35 5 0 25 35-20 16-43 0-25Z" fill="#d78383" opacity="0"/>
    <rect x="-55" y="-111" width="125" height="127" fill="transparent"/>
  </g>
  <g fill="#7e9164" font-family="monospace" font-size="12" letter-spacing="3" aria-hidden="true"><text x="34" y="42">A LITTLE YARD</text><text x="813" y="550">CAT / 002</text></g>
</svg>
<style>
  .yard-scene { display: block; width: 100%; height: auto; user-select: none; touch-action: pan-y; }
  [role="button"] { cursor: pointer; outline: none; touch-action: none; }
  [role="button"]:focus-visible { filter: drop-shadow(0 0 5px #436846); }
</style>
