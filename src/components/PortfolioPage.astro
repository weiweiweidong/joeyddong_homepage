---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages, type Locale } from '../lib/i18n';
import { portfolio } from '../lib/portfolio';
import { site } from '../lib/site';
import portrait from '../../public/images/portfolio-portrait.jpg';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = portfolio[locale];
---

<BaseLayout locale={locale} page="portfolio" title={`${site.name} — ${messages[locale].navigation.portfolio}`} description={copy.description}>
  <main id="main-content" class="shell portfolio-main">
    <section class="portfolio-hero" aria-labelledby="portfolio-title">
      <div class="portfolio-hero-copy">
        <h1 id="portfolio-title">{copy.titleLines.map((line) => <span class="portfolio-title-line">{line}</span>)}</h1>
        <p class="portfolio-tagline">{copy.tagline}</p>
      </div>
      <img class="portfolio-portrait" src={portrait.src} width={portrait.width} height={portrait.height} alt={copy.portraitAlt} fetchpriority="high" />
    </section>
    <div class="portfolio-content">
      <section aria-labelledby="about-title">
        <h2 id="about-title">{copy.aboutTitle}</h2>
        <div class="portfolio-prose">{copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      </section>
      <section aria-labelledby="education-title">
        <h2 id="education-title">{copy.educationTitle}</h2>
        <ul class="portfolio-education">
          {copy.education.map((item) => <li><h3>{item.school}</h3><p class="portfolio-degree">{item.degree}</p><p>{item.detail}</p></li>)}
        </ul>
      </section>
      <section aria-labelledby="explore-title">
        <h2 id="explore-title">{copy.exploreTitle}</h2>
        <div class="portfolio-cards">
          {copy.explorations.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </section>
      <section aria-labelledby="life-title">
        <h2 id="life-title">{copy.lifeTitle}</h2>
        <div class="portfolio-prose portfolio-interests">
          {copy.interests.map((item) => <article><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
      </section>
      <section aria-labelledby="contact-title">
        <h2 id="contact-title">{copy.contactTitle}</h2>
        <a class="text-link" href={site.github}>GitHub: weiweiweidong <span aria-hidden="true">↗</span></a>
      </section>
    </div>
  </main>
</BaseLayout>
