---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pagePath, type Locale } from '../lib/i18n';
import { fadeCopy, fadeExamples, fadeLinks, fadeTags, fadePublication } from '../lib/fade-py';
import { site } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = fadeCopy[locale];
---
<BaseLayout locale={locale} page="projects/fade-py" title={`${copy.name} — ${site.name}`} description={copy.description}>
  <main class="shell fade-main" id="main-content">
    <header class="fade-intro">
      <a class="project-back" href={pagePath(locale, 'projects')}>← {copy.back}</a>
      <p class="eyebrow">{copy.badge}</p>
      <h1><span class="fade-name">FADE</span><span class="fade-title">{copy.title}</span></h1>
      <p class="intro-description">{copy.intro}</p>
      <div class="intro-actions">
        <a class="action-link" href={fadeLinks.github} target="_blank" rel="noopener noreferrer">{copy.github} <span aria-hidden="true">↗</span></a>
        <ul class="tags" aria-label={locale === 'zh' ? '项目技术' : locale === 'ja' ? '使用技術' : 'Project technologies'}>{fadeTags.map(tag => <li>{tag}</li>)}</ul>
      </div>
    </header>

    <section class="reference-section" aria-labelledby="reference-title">
      <div class="section-intro"><h2 id="reference-title">{copy.referenceTitle}</h2><p>{copy.referenceIntro}</p><p>{copy.referenceContext}</p></div>
      <blockquote><cite>{fadePublication.title}</cite><p>{fadePublication.authors}</p><p>{fadePublication.citation}</p><p>DOI: <a href={fadeLinks.publication} target="_blank" rel="noopener noreferrer">{fadePublication.doi}</a></p></blockquote>
      <div class="resource-links"><a href={fadeLinks.publication} target="_blank" rel="noopener noreferrer">{copy.publication} ↗</a><a href={fadeLinks.paper} target="_blank" rel="noopener noreferrer">{copy.paper} ↗</a></div>
    </section>

    <section class="examples cream-panel" aria-labelledby="examples-title" data-fade-examples>
      <div class="section-intro">
        <p class="eyebrow">01 / FADE</p>
        <h2 id="examples-title">{copy.examplesTitle}</h2>
        <p>{copy.examplesIntro}</p>
        <p class="higher"><strong>{copy.higher}</strong></p>
      </div>
      <div class="example-controls" role="group" aria-label={copy.selectExample} data-example-controls hidden>
        {fadeExamples.examples.map((example, index) => (
          <button type="button" class="example-button" data-example={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`fade-panel-${index}`}>
            <img src={example.original} alt="" width="72" height="72" loading="lazy" />
            <span class="button-copy"><span>{copy.sampleNames[index]}</span><span class="button-score">FADE {example.score.toFixed(4)}</span><span class="selected-label" aria-hidden="true">{copy.selected}</span></span>
          </button>
        ))}
      </div>
      <noscript><p class="no-script">{copy.noScript} <a href={fadeLinks.github}>GitHub ↗</a></p></noscript>
      {fadeExamples.examples.map((example, index) => (
        <div class="example-panel" id={`fade-panel-${index}`} data-example-panel={index} hidden={index !== 0}>
          <div class="result-heading">
            <div><h3>{copy.sampleNames[index]}</h3><p>{copy.sampleDescriptions[index]}</p></div>
            <div class="score"><span>{copy.score}</span><strong>{example.score.toFixed(4)}</strong></div>
          </div>
          <div class="result-pair">
            <figure>
              <figcaption>{copy.original}</figcaption>
              <div class="image-frame"><img src={example.original} alt={copy.sampleNames[index]} width={example.width} height={example.height} loading={index === 0 ? 'eager' : 'lazy'} /></div>
              <p class="image-dimensions">{example.width} × {example.height} px</p>
            </figure>
            <figure>
              <figcaption>{copy.density}</figcaption>
              <div class="image-frame"><img class="density-map" src={example.map} alt={`${copy.sampleNames[index]} — ${copy.mapAlt}`} width={example.mapWidth} height={example.mapHeight} loading={index === 0 ? 'eager' : 'lazy'} /></div>
              <p class="image-dimensions">{copy.grid}: {example.mapWidth} × {example.mapHeight} {copy.patches} · {copy.invalidCount}: {example.invalidPatches}</p>
            </figure>
          </div>
        </div>
      ))}
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-example-status></p>
      <div class="density-legend">
        <div class="scale-legend"><p>{copy.scale}</p><div class="scale-bar" aria-hidden="true"></div><div class="scale-values"><span>0 · {copy.low}</span><span>{fadeExamples.scaleMax.toFixed(4)} · {copy.high}</span></div></div>
        <p class="invalid-key"><span aria-hidden="true"></span>{copy.invalid}</p>
      </div>
      <div class="example-notes"><p>{copy.sceneNote}</p><p>{copy.mapNote}</p><p>{copy.scoreNote}</p><a class="source-link" href={fadeLinks.source} target="_blank" rel="noopener noreferrer">{copy.assetSource} ↗</a></div>
    </section>

    <section class="method-section" aria-labelledby="method-title">
      <div class="section-intro"><p class="eyebrow">02 / FADE</p><h2 id="method-title">{copy.methodTitle}</h2><p>{copy.methodIntro}</p><p>{copy.methodReason}</p></div>
      <h3 class="method-subtitle">{copy.featuresTitle}</h3>
      <div class="feature-groups">{copy.featureGroups.map(group => <article><p class="eyebrow">{group.range}</p><h4>{group.title}</h4><p>{group.body}</p></article>)}</div>
      <h3 class="method-subtitle">{copy.flowTitle}</h3>
      <ol class="method-steps">{copy.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">0{index + 1}</span><h4>{step.title}</h4><p>{step.body}</p></li>)}</ol>
      <div class="output-branch cream-panel">
        <h3>{copy.outputsTitle}</h3>
        <div class="output-grid">{copy.outputs.map((output, index) => (
          <article>
            <h4>{output.title}</h4>
            <p class="score-formula" role="math" aria-label={output.formulaLabel}>
              <span aria-hidden="true"><var>D</var>{index === 1 && <><sub>map</sub>(b)</>} = </span>
              <span class="fraction" aria-hidden="true">
                <span>{index === 0 ? <><var>D</var><sub>f</sub></> : <><var>d</var><sub>free</sub>(b)</>}</span>
                <span>{index === 0 ? <><var>D</var><sub>ff</sub></> : <><var>d</var><sub>foggy</sub>(b)</>} + 1</span>
              </span>
            </p>
            <p>{output.body}</p>
          </article>
        ))}</div>
        <div class="output-explanation"><p>{copy.distanceKey}</p><p>{copy.outputNote}</p></div>
      </div>
      <aside class="implementation-note" aria-labelledby="implementation-title"><h3 id="implementation-title">{copy.implementationTitle}</h3><p>{copy.implementationNote}</p></aside>
      <div class="resource-links"><a href={fadeLinks.technical[locale]} target="_blank" rel="noopener noreferrer">{copy.technical} ↗</a></div>
    </section>

    <section class="work-section cream-panel" aria-labelledby="work-title">
      <div class="section-intro"><p class="eyebrow">03 / PYTHON</p><h2 id="work-title">{copy.workTitle}</h2><p>{copy.workIntro}</p></div>
      <div class="contributions">{copy.contributions.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    </section>

  </main>
</BaseLayout>

<script>
  import { fadeCopy, fadeExamples } from '../lib/fade-py';
  import { isLocale } from '../lib/locale-preference';
  const root = document.querySelector<HTMLElement>('[data-fade-examples]');
  const locale = document.documentElement.dataset.locale;
  if (root && isLocale(locale)) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-example]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-example-panel]'));
    const status = root.querySelector<HTMLElement>('[data-example-status]');
    const copy = fadeCopy[locale];
    function selectExample(index: number, announce = true) {
      buttons.forEach((button, position) => button.setAttribute('aria-pressed', String(position === index)));
      panels.forEach((panel, position) => { panel.hidden = position !== index; });
      if (announce && status) status.textContent = `${copy.sampleNames[index]}. ${copy.score}: ${fadeExamples.examples[index].score.toFixed(4)}.`;
    }
    buttons.forEach((button, index) => button.addEventListener('click', () => selectExample(index)));
    root.querySelector<HTMLElement>('[data-example-controls]')?.removeAttribute('hidden');
    // Also reset when restored from the browser's back/forward cache.
    window.addEventListener('pageshow', () => selectExample(0, false));
  }
</script>

<style>
  [hidden] { display: none !important; }
  .fade-main { padding-block: clamp(40px, 6vw, 80px) 100px; }
  .fade-intro { max-width: 950px; margin-bottom: 56px; }
  .project-back { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-bottom: 24px; font-size: 14px; }
  .project-back:hover, .source-link:hover, .resource-links a:hover { text-decoration: underline; }
  h1 { margin-top: 16px; letter-spacing: -.045em; line-height: 1.12; }
  h1 span { display: block; }
  .fade-name { font-size: clamp(72px, 11vw, 142px); }
  .fade-title { margin-top: 12px; font-size: clamp(30px, 4.6vw, 56px); text-wrap: balance; }
  .intro-description { max-width: 820px; margin-top: 28px; font-size: 18px; line-height: 1.85; }
  .intro-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 28px; }
  .action-link { display: inline-flex; justify-content: space-between; align-items: center; gap: 28px; min-height: 48px; padding: 12px 20px; border-radius: 999px; background: #fff4dc; color: var(--color-ink); font-size: 14px; font-weight: 700; }
  .action-link:hover { background: #ffe8a5; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .tags li { border: 1px solid var(--color-line); border-radius: 5px; padding: 4px 10px; font-size: 12px; }
  section + section { margin-top: clamp(48px, 6vw, 80px); }
  .cream-panel { padding: clamp(24px, 4vw, 52px); border-radius: 22px; background: #fff4dc; color: var(--color-ink); }
  .section-intro h2 { margin-top: 12px; font-size: clamp(28px, 3.6vw, 44px); line-height: 1.25; letter-spacing: -.035em; text-wrap: balance; }
  .section-intro > p:not(.eyebrow) { max-width: 800px; margin-top: 20px; font-size: 17px; line-height: 1.85; }
  .cream-panel .eyebrow { color: #7a554d; }
  .section-intro .higher { margin-top: 12px !important; }
  .example-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 28px; }
  .example-button { display: flex; align-items: center; gap: 14px; min-width: 0; padding: 12px; border: 2px solid #25262830; border-radius: 12px; background: transparent; color: var(--color-ink); text-align: left; cursor: pointer; }
  .example-button:hover { border-color: #25262880; }
  .example-button[aria-pressed="true"] { border-color: #252628; background: #f4e1bb; box-shadow: inset 0 0 0 1px #252628; }
  .example-button img { width: 60px; height: 72px; flex-shrink: 0; object-fit: cover; border-radius: 5px; }
  .button-copy { display: flex; flex-direction: column; gap: 4px; font-size: 15px; font-weight: 700; }
  .button-score { font-size: 12px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .selected-label { font-size: 10px; visibility: hidden; }
  .example-button[aria-pressed="true"] .selected-label { visibility: visible; }
  .result-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-block: 32px 24px; }
  .result-heading h3 { font-size: 26px; letter-spacing: -.025em; }
  .result-heading p { max-width: 580px; margin-top: 8px; font-size: 15px; }
  .score { display: flex; align-items: center; flex-wrap: wrap; flex-shrink: 0; gap: 8px 12px; max-width: 100%; padding: 10px 14px; background: #f4e1bb; border-radius: 8px; text-align: left; }
  .score span { font-size: 12px; }
  .score strong { font-size: 22px; font-variant-numeric: tabular-nums; line-height: 1.35; letter-spacing: -.02em; }
  .result-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  figure { min-width: 0; }
  figcaption { margin-bottom: 12px; font-size: 14px; font-weight: 700; }
  .image-frame { height: clamp(300px, 35vw, 440px); display: flex; justify-content: center; align-items: center; overflow: hidden; background: #eaddbf; border-radius: 10px; }
  .image-frame img { width: 100%; height: 100%; object-fit: contain; }
  .density-map { image-rendering: pixelated; }
  .image-dimensions { margin-top: 10px; font-size: 11px; line-height: 1.6; font-variant-numeric: tabular-nums; }
  .density-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 28px; }
  .scale-legend { flex: 1; min-width: 200px; max-width: 500px; font-size: 12px; }
  .scale-bar { height: 14px; margin-top: 10px; border: 1px solid #25262860; border-radius: 3px; background: linear-gradient(to right, #000, #fff); }
  .scale-values { display: flex; justify-content: space-between; gap: 20px; margin-top: 6px; font-size: 11px; font-variant-numeric: tabular-nums; }
  .invalid-key { display: flex; align-items: center; gap: 8px; font-size: 12px; }
  .invalid-key > span { width: 14px; height: 14px; border: 1px solid #25262860; border-radius: 2px; background: #cf4c93; }
  .example-notes { border-top: 1px solid #25262825; padding-top: 22px; margin-top: 24px; }
  .example-notes p { max-width: 900px; font-size: 13px; line-height: 1.8; }
  .example-notes p + p { margin-top: 10px; }
  .source-link { display: inline-block; margin-top: 12px; font-size: 12px; text-decoration: underline; }
  .no-script { margin-top: 24px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .method-subtitle { margin-top: 40px; font-size: clamp(23px, 2.6vw, 30px); letter-spacing: -.025em; line-height: 1.4; }
  .feature-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 22px; }
  .feature-groups article { min-width: 0; padding: 24px; border-radius: 14px; background: #fff4dc; color: var(--color-ink); }
  .feature-groups .eyebrow { color: #7a554d; font-size: 11px; }
  .feature-groups h4 { margin: 14px 0 0; font-size: 21px; line-height: 1.4; }
  .feature-groups p:not(.eyebrow) { margin-top: 12px; font-size: 15px; line-height: 1.85; }
  .method-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 26px; margin: 24px 0 0; padding: 0; list-style: none; }
  .method-steps li { border-top: 1px solid var(--color-line); padding-top: 20px; }
  .step-number { font-size: 13px; font-variant-numeric: tabular-nums; }
  .method-steps h4 { margin: 18px 0 0; font-size: 21px; line-height: 1.4; }
  .method-steps p, .contributions p { margin-top: 12px; font-size: 15px; line-height: 1.85; }
  .output-branch { margin-top: 36px; }
  .output-branch > h3 { font-size: clamp(23px, 2.6vw, 30px); line-height: 1.4; letter-spacing: -.025em; }
  .output-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 26px; }
  .output-grid article { min-width: 0; border-top: 1px solid #25262830; padding-top: 20px; }
  .output-grid h4 { margin: 0; font-size: 21px; }
  .output-grid article > p:not(.score-formula) { font-size: 15px; line-height: 1.85; }
  .score-formula { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; min-height: 76px; margin-block: 18px; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; line-height: 1.5; }
  .score-formula sub { font-size: 12px; }
  .fraction { display: inline-grid; text-align: center; }
  .fraction > span { padding: 2px 8px; }
  .fraction > span + span { border-top: 1px solid currentColor; }
  .output-explanation { border-top: 1px solid #25262825; margin-top: 26px; padding-top: 20px; font-size: 13px; line-height: 1.85; }
  .output-explanation p + p { margin-top: 10px; }
  .implementation-note { border-left: 3px solid #fff4dc; margin-top: 32px; padding-left: 22px; }
  .implementation-note h3 { font-size: 21px; }
  .implementation-note p { max-width: 1000px; margin-top: 14px; font-size: 15px; line-height: 1.85; }
  .contributions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-top: 32px; }
  .contributions article { padding-top: 22px; border-top: 1px solid #25262830; }
  .contributions h3 { font-size: 22px; }
  .resource-links { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 22px; font-size: 15px; }
  .resource-links a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; }
  .reference-section { border-top: 1px solid var(--color-line); padding-top: 32px; }
  blockquote { border-left: 3px solid #fff4dc; margin: 28px 0; padding-left: 24px; max-width: 850px; font-size: 15px; line-height: 1.85; }
  cite { display: block; margin-block: 6px; font-style: normal; font-weight: 700; }
  blockquote a { overflow-wrap: anywhere; text-decoration: underline; }
  @media (max-width: 1000px) { .example-button { flex-direction: column; align-items: flex-start; } .example-button img { width: 100%; height: 86px; } .method-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } .feature-groups { grid-template-columns: minmax(0, 1fr); } .contributions { grid-template-columns: minmax(0, 1fr); gap: 22px; } }
  @media (max-width: 700px) {
    .fade-intro { margin-bottom: 36px; } .cream-panel { padding: 22px; border-radius: 16px; }
    .example-controls { gap: 8px; } .example-button { padding: 8px; gap: 8px; } .button-copy { font-size: 12px; } .button-score { font-size: 10px; }
    .result-heading { align-items: flex-start; flex-direction: column; gap: 14px; } .score { text-align: left; }
    .result-pair { grid-template-columns: minmax(0, 1fr); gap: 22px; } .image-frame { height: clamp(240px, 78vw, 400px); }
    .section-intro > p:not(.eyebrow) { font-size: 16px; } .intro-description { font-size: 17px; }
    .method-steps { grid-template-columns: minmax(0, 1fr); gap: 22px; } .method-steps h4 { margin-top: 10px; }
    .output-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; } .resource-links { gap: 8px 20px; }
  }
  @media (max-width: 380px) {
    .example-controls { grid-template-columns: minmax(0, 1fr); }
    .example-button { flex-direction: row; align-items: center; gap: 12px; }
    .example-button img { width: 46px; height: 54px; }
    .button-copy { flex: 1; display: grid; grid-template-columns: 1fr auto; align-items: center; }
    .button-score { grid-row: 2; } .selected-label { grid-column: 2; grid-row: 1 / 3; }
  }
</style>
