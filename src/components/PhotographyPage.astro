---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Locale } from '../lib/i18n';
import { photos, photography, photoSrcset } from '../lib/photography';
import { site } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = photography[locale];
---

<BaseLayout locale={locale} page="photography" title={`${site.name} — Photography`} description={copy.description}>
  <main id="main-content" class="shell photography-main">
    <section class="photography-hero" aria-labelledby="photography-title">
      <div class="photography-intro">
        <h1 id="photography-title">{copy.title}</h1>
        <p class="photography-welcome">{copy.welcome}</p>
        <p class="photography-description">{copy.intro}</p>
        <p class="photography-note">{copy.note}</p>
        <p class="photography-invitation"><strong>{copy.invitation}</strong></p>
      </div>
      <div class="photography-cover">
        <div class="photography-cover-frame photography-cover-frame-back" aria-hidden="true">
          <img src={photos[2].previews["640"].src} srcset={photoSrcset(photos[2])} sizes="(max-width: 700px) 196px, 261px" width={photos[2].width} height={photos[2].height} alt="" decoding="async" />
        </div>
        <div class="photography-cover-frame">
          <img src={photos[0].previews["640"].src} srcset={photoSrcset(photos[0])} sizes="(max-width: 700px) 196px, 261px" width={photos[0].width} height={photos[0].height} alt={`${copy.photo} 01`} fetchpriority="high" />
        </div>
      </div>
    </section>
    <section class="photography-collection" id="photographs" aria-labelledby="collection-title">
      <div class="photography-collection-heading">
        <h2 id="collection-title">{copy.collection}</h2>
      </div>
      <div class="photo-grid">
        {photos.map((photo) => (
          <figure class="photo-item">
            <a class="photo-link" href={photo.url} data-photo-id={photo.id} data-preview={photo.previews["640"].src} data-thumbnail={photo.previews["320"].src} data-width={photo.width} data-height={photo.height} aria-label={`${copy.view} ${photo.id}`}>
              <img src={photo.previews["640"].src} srcset={photoSrcset(photo)} sizes="(max-width: 480px) calc(100vw - 48px), (max-width: 700px) calc((100vw - clamp(24px, 4.6vw, 64px) - clamp(24px, 4.6vw, 64px) - 16px) / 2), (max-width: 1000px) calc((100vw - 9.2vw - 48px) / 3), (min-width: 1400px) 294px, calc((min(100vw, 1376px) - clamp(24px, 4.6vw, 64px) - clamp(24px, 4.6vw, 64px) - 72px) / 4)" alt={`${copy.photo} ${String(photo.id).padStart(2, '0')}`} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
            </a>
          </figure>
        ))}
      </div>
    </section>
    <div class="photography-outro"><p>{copy.quote}</p></div>
  </main>
  <dialog class="photo-viewer" aria-label={copy.view} data-loading={copy.loading} data-error={copy.loadError}>
    <img class="photo-viewer-ambient" alt="" aria-hidden="true" />
    <div class="photo-viewer-toolbar">
      <div class="photo-viewer-heading"><span>Photography</span><p class="photo-viewer-count" aria-live="polite"></p></div>
      <button type="button" class="photo-viewer-close" aria-label={copy.close}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </div>
    <div class="photo-viewer-stage">
      <button type="button" class="photo-viewer-previous" aria-label={copy.previous}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg></button>
      <div class="photo-carousel">
        <div class="photo-carousel-track">
          <img class="photo-viewer-image" alt="" aria-hidden="true" draggable="false" />
          <img class="photo-viewer-image" alt="" draggable="false" />
          <img class="photo-viewer-image" alt="" aria-hidden="true" draggable="false" />
        </div>
      </div>
      <button type="button" class="photo-viewer-next" aria-label={copy.next}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg></button>
    </div>
    <div class="photo-viewer-footer">
      <div class="photo-filmstrip" role="group" aria-label={copy.collection}>
        {Array.from({ length: 7 }, () => <button type="button" class="photo-thumbnail"><img alt="" draggable="false" /></button>)}
      </div>
      <div class="photo-viewer-feedback"><span class="photo-hd-status" role="status" aria-live="polite"></span><button class="photo-hd-retry" type="button" hidden>{copy.retry}</button></div>
      <a class="photo-viewer-original" target="_blank" rel="noopener noreferrer">{copy.original} ↗</a>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { chooseHighResolutionEdge, highResolutionUrl, createPhotoLoader } from '../lib/photography-loader';
  const viewer = document.querySelector<HTMLDialogElement>('.photo-viewer');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.photo-link'));
  const carousel = viewer?.querySelector<HTMLElement>('.photo-carousel');
  const track = viewer?.querySelector<HTMLElement>('.photo-carousel-track');
  const images = Array.from(viewer?.querySelectorAll<HTMLImageElement>('.photo-viewer-image') ?? []);
  let transition: Animation | undefined;
  const counter = viewer?.querySelector<HTMLElement>('.photo-viewer-count');
  const original = viewer?.querySelector<HTMLAnchorElement>('.photo-viewer-original');
  const ambient = viewer?.querySelector<HTMLImageElement>('.photo-viewer-ambient');
  const thumbnails = Array.from(viewer?.querySelectorAll<HTMLButtonElement>('.photo-thumbnail') ?? []);
  const status = viewer?.querySelector<HTMLElement>('.photo-hd-status');
  const retry = viewer?.querySelector<HTMLButtonElement>('.photo-hd-retry');
  const loader = createPhotoLoader();
  let scheduled = 0;
  const clearRequest = () => {
    cancelAnimationFrame(scheduled);
    loader.invalidate();
    if (status) status.textContent = '';
    if (retry) retry.hidden = true;
  };
  let current = 0;
  let opener: HTMLAnchorElement | undefined;
  const loadCurrent = () => {
    if (!viewer?.open || !carousel || !images[1] || transition) return;
    const link = links[current];
    const edge = chooseHighResolutionEdge(Number(link.dataset.width), Number(link.dataset.height), carousel.clientWidth, carousel.clientHeight, window.devicePixelRatio);
    const url = highResolutionUrl(link.href, edge);
    if (status) status.textContent = viewer.dataset.loading ?? '';
    if (retry) retry.hidden = true;
    loader.load(url, result => {
      images[1].src = result;
      if (status) status.textContent = '';
    }, () => {
      if (status) status.textContent = viewer.dataset.error ?? '';
      if (retry) retry.hidden = false;
    });
  };
  const scheduleCurrent = () => {
    cancelAnimationFrame(scheduled);
    scheduled = requestAnimationFrame(loadCurrent);
  };
  retry?.addEventListener('click', loadCurrent);
  const show = (index: number) => {
    clearRequest();
    current = (index + links.length) % links.length;
    const link = links[current];
    if (!counter || !original || !link) return;
    images.forEach((image, slot) => {
      const slide = links[(current + slot - 1 + links.length) % links.length];
      image.src = slide.dataset.preview ?? '';
      image.width = Number(slide.dataset.width);
      image.height = Number(slide.dataset.height);
      image.alt = slot === 1 ? slide.querySelector('img')?.alt ?? '' : '';
    });
    counter.textContent = `${String(current + 1).padStart(2, '0')} / ${links.length}`;
    original.href = link.href;
    if (ambient) ambient.src = link.dataset.thumbnail ?? '';
    thumbnails.forEach((button, slot) => {
      const index = (current + slot - 3 + links.length) % links.length;
      const slide = links[index];
      button.dataset.index = String(index);
      button.setAttribute('aria-label', slide.getAttribute('aria-label') ?? '');
      button.setAttribute('aria-current', slot === 3 ? 'true' : 'false');
      const thumb = button.querySelector('img');
      if (thumb) thumb.src = slide.dataset.thumbnail ?? '';
    });
    if (viewer?.open) scheduleCurrent();
  };
  const move = (direction: number) => {
    if (!viewer?.open || !track || transition) return;
    clearRequest();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      show(current + direction);
      return;
    }
    transition = track.animate([
      { transform: 'translateX(-100%)' },
      { transform: `translateX(${direction > 0 ? '-200%' : '0%'})` },
    ], { duration: 360, easing: 'cubic-bezier(.22,.68,0,1)', fill: 'forwards' });
    const active = transition;
    active.finished.then(() => {
      show(current + direction);
      active.cancel();
      transition = undefined;
    }, () => {});
  };
  thumbnails.forEach((button) => button.addEventListener('click', () => {
    transition?.cancel();
    transition = undefined;
    show(Number(button.dataset.index));
  }));
  let touchStart: { x: number; y: number } | undefined;
  carousel?.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse') return;
    touchStart = { x: event.clientX, y: event.clientY };
    carousel.setPointerCapture(event.pointerId);
  });
  carousel?.addEventListener('pointerup', (event) => {
    if (!touchStart) return;
    const dx = event.clientX - touchStart.x;
    const dy = event.clientY - touchStart.y;
    touchStart = undefined;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) move(dx < 0 ? 1 : -1);
  });
  carousel?.addEventListener('pointercancel', () => { touchStart = undefined; });
  links.forEach((link, index) => link.addEventListener('click', (event) => {
    if (!viewer || typeof viewer.showModal !== 'function' || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    opener = link;
    show(index);
    viewer.showModal();
    document.body.classList.add('photo-viewer-open');
    scheduleCurrent();
  }));
  viewer?.querySelector('.photo-viewer-close')?.addEventListener('click', () => viewer.close());
  viewer?.querySelector('.photo-viewer-previous')?.addEventListener('click', () => move(-1));
  viewer?.querySelector('.photo-viewer-next')?.addEventListener('click', () => move(1));
  viewer?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      move(event.key === 'ArrowLeft' ? -1 : 1);
    }
  });
  viewer?.addEventListener('click', (event) => { if (event.target === viewer) viewer.close(); });
  viewer?.addEventListener('close', () => {
    clearRequest();
    document.body.classList.remove('photo-viewer-open');
    transition?.cancel();
    transition = undefined;
    touchStart = undefined;
    images.forEach((image) => image.removeAttribute('src'));
    ambient?.removeAttribute('src');
    opener?.focus({ preventScroll: true });
  });
</script>
